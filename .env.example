# ローカル開発専用。コピー先の .env はGit管理しません。
APP_PORT=8080
MYSQL_PORT=3306
# 他プロジェクトが5173を使用中の場合は空いているポート（例: 5174）に変更する。
FRONTEND_PORT=5173

PHP_VERSION=8.5
MYSQL_VERSION=8.4
NODE_VERSION=24

MYSQL_DATABASE=snick_platform
MYSQL_USER=snick
MYSQL_PASSWORD=snick_dev_password
MYSQL_ROOT_PASSWORD=snick_root_dev_password

